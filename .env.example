PORT=3003

# ============================================
# PAINEL ADMIN (obrigatório em produção)
# ============================================
# Cookie HttpOnly. Não commitar a senha real.
# Gere o segredo com: openssl rand -hex 32
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
ADMIN_SESSION_SECRET=troque-por-openssl-rand-hex-32
# Se PORT estiver ocupada, o servidor tenta PORT+1 até PORT+PORT_FALLBACK_MAX (padrão 40)
# PORT_FALLBACK_MAX=40

# ============================================
# DATABASE
# ============================================
# App (piloto): ainda usa SQLite em runtime. Postgres sobe no Compose (Evolution + preparação M3).
# Caminho persistente no Docker: /app/data/attendance.db
# SQLITE_PATH=./attendance.db
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=reboque_inteligente
PG_USER=postgres
PG_PASSWORD=postgres
# Corte completo app→Postgres = milestone M3b (DB_DRIVER=postgres)

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# OPENAI - Agente Atendente (LLM)
# ============================================
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Endpoint compatível com OpenAI (OpenCode local: instale opencode-llm-proxy no OpenCode e use):
# OPENAI_BASE_URL=http://127.0.0.1:4010/v1
# OPENAI_API_KEY=local
# OPENAI_MODEL=ollama/qwen2.5-coder
# Alias opcional de OPENAI_BASE_URL:
# OPENCODE_LLM_BASE_URL=http://127.0.0.1:4010/v1
# OPENCODE_LLM_PROXY_TOKEN=

# ============================================
# SGA — proteção veicular (API) + associado local (opcional)
# ============================================
# URL base da API (sem barra final). O servidor chama GET {base}{SGA_VEHICLE_PATH} ao confirmar o atendimento.
# SGA_API_BASE_URL=https://api.exemplo.com
# Path após a base com parâmetro de placa/chassi (padrão da doc SGA).
# Use :placaOuChassi ou {placaOuChassi} no path.
# SGA_VEHICLE_PATH=/buscar/situacao-veiculo/:placaOuChassi
# SGA_API_KEY=
# Credenciais do usuário SGA (obter token_usuario em /usuario/autenticar)
# SGA_AUTH_USER=
# SGA_AUTH_PASSWORD=
# Path de autenticação (padrão da documentação)
# SGA_AUTH_PATH=/usuario/autenticar
# SGA_TIMEOUT_MS=20000
# Máximo de variantes de placa testadas na URL (hífen, minúsculas, O/0). Padrão 12.
# SGA_PLATE_VARIANTS_MAX=12

# Códigos de situação considerados ATIVOS (separados por vírgula). Hinova: costuma ser 1 para ATIVO (veja descricao_situacao no JSON).
# O app também usa descricao_situacao=ATIVO quando existir. Padrão 1,9.
# SGA_ACTIVE_STATUS_CODES=1,9
# Loga no servidor codigo_situacao + lista permitida + resultado parseado (útil para calibrar o código acima).
# SGA_DEBUG=true
# Em desenvolvimento, pula a chamada HTTP (não use em produção).
# SGA_SKIP_VEHICLE_VERIFY=true

# Validação extra por telefone na tabela local sga_associates (além da API de veículo acima).
# SGA_VALIDATE_ASSOCIATES=true
# Cadastre telefones em sga_associates (SQLite) ou use Configurações no painel web.

# ============================================
# ATENDIMENTO — fluxo de coleta (questionário)
# ============================================
# brief = 4 perguntas (origem, destino, placa, serviço) + confirmação — padrão emergência
# full  = questionário completo legado (nome, agendamento, acesso, receptor, etc.)
ATTENDANCE_FLOW=brief

# ============================================
# ATENDIMENTO — fluxo legado no orquestrador (simulateInboundAttendance)
# Padrão: desligado. Use sempre o attendant (uma pergunta por vez), com ou sem OPENAI_API_KEY.
# true = apenas para testar o fluxo antigo do orquestrador
# SIMULATE_ATTENDANCE=false
# SIMULATE_DEFAULT_LAT=-23.5505
# SIMULATE_DEFAULT_LNG=-46.6333

# Coordenadas padrão ao cadastrar prestador sem lat/lng válidos (centro SP)
# DEFAULT_PROVIDER_LAT=-23.5505
# DEFAULT_PROVIDER_LNG=-46.6333

# ============================================
# WHATSAPP - Evolution API
# ============================================
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=minhachavesecreta
WHATSAPP_INSTANCE=sga-instance

# Docker Compose (app + evolution na mesma rede):
# EVOLUTION_API_URL é forçado para http://evolution-api:8080 dentro do container.
# O webhook também é interno (http://app:3003/api/whatsapp/webhook) e não precisa ser público.
# URL que o navegador/celular usa para abrir o Manager e ler o QR:
# EVOLUTION_SERVER_URL=http://SEU_IP:8080
# Domínio + HTTPS (perfil compose "https"):
# APP_DOMAIN=reboque.seudominio.com
# ACME_EMAIL=voce@seudominio.com

# Testes sem responder todo mundo no WhatsApp:
# WHATSAPP_INBOUND_DISABLED=true   → mensagens só são salvas; o bot NÃO processa (não responde).
# TEST_MODE=true                   → restrito à allowlist (veja aba Conversas).
# TEST_ALLOWLIST=5531999999999

# Espelho: recebe a mesma mensagem de cotação enviada aos prestadores (útil em testes). Força envio mesmo em TEST_MODE (allowlist).
# DDD sem 55: o servidor prefixa 55. Ex.: 5531991832759 ou 31991832759
# QUOTE_MIRROR_WHATSAPP=5531991832759

# ============================================
# CONSULTA DE VEÍCULO POR PLACA (API Brasil)
# ============================================
# Token Bearer do painel API Brasil (obrigatório mesmo em homolog).
# APIBRASIL_HOMOLOG=true → testa sem cobrança (mesmo shape). Produção cobra por consulta.
# Cache em memória 24h; sem retry automático em 4xx.
# APIBRASIL_TOKEN=
# APIBRASIL_HOMOLOG=true
# APIBRASIL_TIMEOUT_MS=12000
# VEHICLE_LOOKUP_DISABLED=false

# ============================================
# GOOGLE MAPS (Fase 2+ - ETA e rotas)
# ============================================
# GOOGLE_MAPS_API_KEY=your-key-here
# true = em cada cotação, mescla Places com o cadastro local e escolhe os max_providers mais próximos (exige chave válida).
# false (padrão) = só chama Places se no SQLite houver menos prestadores que max_providers.
# GOOGLE_PLACES_MERGE=false

# ============================================
# PAGAMENTOS (Fase 4)
# ============================================
# MERCADOPAGO_ACCESS_TOKEN=your-token-here

# ============================================
# Diagnóstico WhatsApp (JID / webhook)
# ============================================
# GET /api/debug/whatsapp-inbound?limit=10 com header x-diagnostic-secret: <mesmo valor>
# POST /api/debug/normalize-message-threads — unifica coluna messages.phone (mesmo header; após corrigir formato duplicado na lista de conversas)
# DIAGNOSTIC_SECRET=coloque-um-token-secreto-aqui
