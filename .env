PORT=3003
# Se PORT estiver ocupada, o servidor tenta PORT+1 até PORT+PORT_FALLBACK_MAX (padrão 40)
# PORT_FALLBACK_MAX=40

# ============================================
# DATABASE - PostgreSQL + PostGIS
# ============================================
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=reboque_inteligente
PG_USER=postgres
PG_PASSWORD=postgres

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# OPENAI - Agente Atendente (LLM)
# ============================================
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Endpoint compatível com OpenAI (OpenCode local: instale opencode-llm-proxy no OpenCode e use):
# OPENAI_BASE_URL=http://127.0.0.1:4010/v1
# OPENAI_API_KEY=local
# OPENAI_MODEL=ollama/qwen2.5-coder
# Alias opcional de OPENAI_BASE_URL:
# OPENCODE_LLM_BASE_URL=http://127.0.0.1:4010/v1
# OPENCODE_LLM_PROXY_TOKEN=

# ============================================
# SGA — proteção veicular (API) + associado local (opcional)
# ============================================
# URL base da API (sem barra final). O servidor chama POST {base}{SGA_VEHICLE_PATH} ao confirmar o atendimento.
SGA_AUTH_USER=murilo
SGA_AUTH_PASSWORD=aruaenoiz
SGA_API_BASE_URL=https://api.hinova.com.br/api/sga/v2
SGA_VEHICLE_PATH=/buscar/situacao-veiculo/:placaOuChassi
SGA_API_KEY=c881d86a2ef6211f125dd2139cf5f1133accc6786b7965594785edfc16235440f11892d8e4c4b22b35d85baba99388742b1268963c0587c57e8d98a76ef10722e69f3512290f6b328fd5168332279887
SGA_TIMEOUT_MS=20000
SGA_ACTIVE_STATUS_CODES=1
SGA_SKIP_VEHICLE_VERIFY=false
SGA_DEBUG=true
# Validação extra por telefone na tabela local sga_associates (além da API de veículo acima).
# SGA_VALIDATE_ASSOCIATES=true
# Cadastre telefones em sga_associates (SQLite) ou use Configurações no painel web.

# ============================================
# ATENDIMENTO — fluxo legado no orquestrador (simulateInboundAttendance)
# Padrão: desligado. Use sempre o attendant (uma pergunta por vez), com ou sem OPENAI_API_KEY.
# true = apenas para testar o fluxo antigo do orquestrador
# SIMULATE_ATTENDANCE=false
# SIMULATE_DEFAULT_LAT=-23.5505
# SIMULATE_DEFAULT_LNG=-46.6333

# Coordenadas padrão ao cadastrar prestador sem lat/lng válidos (centro SP)
# DEFAULT_PROVIDER_LAT=-23.5505
# DEFAULT_PROVIDER_LNG=-46.6333

# ============================================
# WHATSAPP - Evolution API
# ============================================
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=minhachavesecreta
WHATSAPP_INSTANCE=sga-instance

